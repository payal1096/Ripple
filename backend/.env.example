# =========================================================
# Ripple Backend Environment Configuration (Example)
# =========================================================

# API Server Settings
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# Security & Authentication (Change in production!)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Architecture ('mongodb' for persistent storage, 'development_in_memory' for mock)
STORAGE_MODE=mongodb

# MongoDB Settings
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=ripple_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
